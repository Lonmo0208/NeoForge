     }
 
     protected void encode(ChannelHandlerContext ctx, Packet<?> msg, List<Object> out) throws Exception {
-        this.bundlerInfo.unbundlePacket(msg, out::add);
+        this.bundlerInfo.unbundlePacket(msg, out::add, ctx);
+        if (out.isEmpty()) {
+            // NeoFobric: MessageToMessageEncoder refuses an empty output with "PacketBundleUnpacker must
+            // produce at least one message" and takes the connection down, so name what was sent while the
+            // packet object is still at hand - a bundle that only carried empty bundles looks non-empty
