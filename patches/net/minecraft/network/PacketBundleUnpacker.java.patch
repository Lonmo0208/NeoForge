+                            msg instanceof net.minecraft.network.protocol.BundlePacket<?> bundle
+                                    ? describeSubPackets(bundle.subPackets())
+                                    : "<not a bundle>");
+        }
         if (msg.isTerminal()) {
             ctx.pipeline().remove(ctx.name());
         }
+    }
+
+    private static String describeSubPackets(Iterable<? extends Packet<?>> subPackets) {
+        var description = new StringBuilder("[");
+        for (var subPacket : subPackets) {
+            if (description.length() > 1) {
+                description.append(", ");
+            }
+            description.append(subPacket.getClass().getSimpleName());
+            if (subPacket instanceof net.minecraft.network.protocol.BundlePacket<?> nested) {
+                description.append('(').append(describeSubPackets(nested.subPackets())).append(')');
+            }
+        }
+        return description.append(']').toString();
     }
