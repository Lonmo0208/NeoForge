# NeoFobric: the fabric-loader checkout is a git submodule (see .gitmodules); it is only needed
# for `-Pneofobric.fabricLoader.local=true`, the default Maven mode does not read it.
# /fabric-loader/ is deliberately NOT ignored - the submodule link is what makes GitHub point at
# the upstream repository instead of an empty directory.
/仅供参考
/fabric

# NeoFobric: our own handoff documentation stays on the maintainer's disk only. It is not for the
# repository and not for GitHub.
/docs/NEOFOBRIC_HANDOFF.md
/docs/handoff/
/docs/FABRIC_BRIDGE.md
/docs/WORLD_LOAD_FAILURE_ANALYSIS.md

# NeoFobric: no prebuilt installer in the repository root. Build it with
# ./gradlew :neoforge:installerJar - the artifact lands in projects/neoforge/build/libs.
/neoforge-fobric-installer.jar

# NeoFobric: JVM exception tracing output (-Xlog:exceptions=trace:file=neofobric-exc.log), see the handoff docs
/neofobric-exc.log*

# local gametest reports
/tmp/

# NeoFobric: the tools the handoff notes tell you to run belong in the repo; only their build output
# stays out. With the whole folder ignored the notes pointed at scripts nobody else could get.
/tools/*
!/tools/*.ps1
!/tools/*.sh
!/tools/mc-api-diff
!/tools/mixin-anchor-verify
!/tools/vanilla-call-diff
!/tools/ctm-helper

# NeoFobric: the diff tool writes its report here
/tools/mc-api-diff/report.txt

# NeoFobric: the verifier compiles itself here
/tools/mixin-anchor-verify/.build/

# NeoFobric: the call diff compiles itself here
/tools/vanilla-call-diff/.build/
.zcodeignore

# NeoFobric: the static mixin reference check the handoff work order tells you to run
!/tools/mixin-targets
/tools/mixin-targets/out/
/tools/mixin-targets/report.txt
/modstaging
